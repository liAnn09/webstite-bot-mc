# ===== Server Minecraft =====
WEB_PORT=3000
WEB_API_KEY=relx-secret-key-123

HOST=play.relxmc.com
PORT=25565
VERSION=1.20.1

# ===== Akun bot (tambah BOT4_..., dst. kalau perlu) =====
# TARGET_X / TARGET_Z = koordinat titik farm untuk !farm (0 = belum diatur, bisa juga lewat !setfarm)
BOT1_USERNAME=ApaanLuu198
BOT1_PASSWORD=your_secret_here
BOT1_TARGET_X=24
BOT1_TARGET_Z=11

BOT2_USERNAME=orangasing1717
BOT2_PASSWORD=your_secret_here
BOT2_TARGET_X=18
BOT2_TARGET_Z=15

BOT3_USERNAME=Uyaakaz
BOT3_PASSWORD=your_secret_here
BOT3_TARGET_X=24
BOT3_TARGET_Z=15

# ===== Discord =====
# Token dari Discord Developer Portal -> Bot -> Reset Token (JANGAN dibagikan ke siapa pun)
DISCORD_TOKEN=your_secret_here
# ID server Discord. Kosong = ketik "server create" di console agar bot membuat server baru,
# atau undang bot ke server kosong lalu isi ID-nya (klik kanan server -> Copy Server ID)
DISCORD_GUILD_ID=1558522829190729990

# --- Diisi OTOMATIS oleh bot setelah server dibangun (jangan diubah kecuali perlu) ---
DISCORD_LOG_CHANNEL_ID=1558525809113956502
DISCORD_CMD_CHANNEL_ID=1558525811299188739
DISCORD_LIVE_CHANNEL_ID=1558525806668415131
DISCORD_OPERATOR_ROLE_ID=1558525796379918448
DISCORD_VIEWER_ROLE_ID=1558525798393323711

# Opsional: ID pengguna yang selalu boleh memakai command (pisahkan dengan koma), di luar role Operator
DISCORD_ALLOWED_USER_IDS=
# Live status otomatis di channel live (detik, minimal 5). 0 = mati. Diisi 10 oleh setup kalau masih kosong.
LIVE_AUTO_SECONDS=10

# ===== Opsional =====
RECONNECT_DELAY=90000
JUMP_MIN_MINUTES=2
JUMP_MAX_MINUTES=4
REJOIN_RETRY_DELAY=10000
REJOIN_MAX_ATTEMPTS=40
# true = setelah masuk ecocpvp & /afk, bot otomatis jalan ke titik farm (BOTn_TARGET_X/Z atau !setfarm)
AUTO_FARM=false
# true (bawaan) = kalau server meminta /register (akun baru), bot mendaftar otomatis memakai BOTn_PASSWORD
AUTO_REGISTER=true

# ===== Spawner: drop bone otomatis =====
# true = pantau Spawner Storage dan drop bone saat mencapai batas (bot harus AFK dekat spawner).
# Per akun juga bisa lewat Discord: !spawner auto on b1
SPAWNER_AUTO=false
SPAWNER_THRESHOLD=500000
# Sisa bone yang dipertahankan setelah drop (0 = habiskan seluruh storage)
SPAWNER_KEEP=0
# Seberapa sering jumlah bone dicek (menit)
SPAWNER_CHECK_MINUTES=5
# Opsional (lanjutan): batas waktu satu sesi drop (menit) dan jeda setelah tiap klik Drop Loot (milidetik)
# SPAWNER_MAX_MINUTES=40
# SPAWNER_CLICK_WAIT_MS=1500
